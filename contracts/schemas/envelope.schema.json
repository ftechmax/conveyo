{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ftechmax/conveyo/contracts/schemas/envelope.schema.json",
  "type": "object",
  "required": [
    "envelopeVersion",
    "messageType",
    "message"
  ],
  "properties": {
    "envelopeVersion": {
      "const": "1"
    },
    "messageId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "destinationAddress": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "messageType": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://github.com/ftechmax/conveyo/contracts/schemas/urn.schema.json"
      }
    },
    "message": {
      "type": "object"
    },
    "sentTime": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,16})?Z$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "headers": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "host": {
      "anyOf": [
        {
          "$ref": "https://github.com/ftechmax/conveyo/contracts/schemas/host.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
