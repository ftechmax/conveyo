{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ftechmax/conveyo/contracts/schemas/manifest.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "file",
      "schemas",
      "valid",
      "kind"
    ],
    "properties": {
      "file": {
        "type": "string"
      },
      "schemas": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "valid": {
        "type": "boolean"
      },
      "kind": {
        "enum": [
          "envelope",
          "payload",
          "fault",
          "postgres-locators",
          "inline",
          "transport",
          "envelope-cases",
          "reference-cases"
        ]
      }
    },
    "additionalProperties": false
  }
}
