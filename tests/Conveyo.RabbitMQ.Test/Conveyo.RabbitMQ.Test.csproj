<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.13.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Conveyo.RabbitMQ\Conveyo.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\IntegrationContainers.cs" Link="IntegrationContainers.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\contracts\fixtures\envelopes\command.json"
          Link="contracts\fixtures\envelopes\command.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\envelopes\message-data-inline.json"
          Link="contracts\fixtures\envelopes\message-data-inline.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\fixtures\envelopes\message-data-pgbin.json"
          Link="contracts\fixtures\envelopes\message-data-pgbin.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../contracts/fixtures/payloads/types.json"
          Link="contracts/fixtures/payloads/types.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../contracts/fixtures/payloads/fault.json"
          Link="contracts/fixtures/payloads/fault.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../contracts/fixtures/transport/rabbitmq.json"
          Link="contracts/fixtures/transport/rabbitmq.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
